# Names only. Real values live in .env (never committed).

# The model provider: any OpenAI-compatible endpoint. A key with no base URL or model refuses to start,
# so a key is never sent to a default host.
LLM_API_KEY=
LLM_BASE_URL=
DRYDOCK_MODEL=
# Example, Groq: LLM_BASE_URL=https://api.groq.com/openai/v1 (pick DRYDOCK_MODEL from your account's limits page)
# Reasoning models: sent as reasoning_effort (default medium; blank = not sent, for providers that reject it)
DRYDOCK_REASONING_EFFORT=medium

# Tokens per minute to pace to; 0 = off. Set it to your account's limit.
LLM_TPM_LIMIT=0
# Other providers, tried when the first is down: base_url|KEY_ENV_NAME|model[|tpm], comma-separated.
# It names the env var that holds the key, never the key. An entry with an empty key env var is skipped.
LLM_FALLBACKS=
LLM_TIMEOUT_S=30
LLM_RETRY_BUDGET_S=90

# Per run: wall clock in seconds and total tokens. Unsourced defaults; tune from a measured run.
DRYDOCK_RUN_DEADLINE_S=240
DRYDOCK_RUN_TOKENS=60000

# Limits for a public URL. GUESSES, not measured: set them from your key's real daily limit.
# Runs per UTC day, all visitors / one IP / one IP free text.
DRYDOCK_DAILY_RUN_CAP=200
DRYDOCK_IP_DAILY_RUNS=10
DRYDOCK_IP_DAILY_TEXT_RUNS=5
# Tokens per UTC day, all visitors: no new run past this. Free text stops at this percent of it, so listed tickets still run.
DRYDOCK_DAILY_TOKENS=150000
# One IP stops at this percent of the daily tokens, so one visitor can't end the day's demo for everyone.
DRYDOCK_IP_TOKEN_PCT=34
DRYDOCK_TEXT_TOKEN_PCT=50
# API reads per minute, one IP. The UI polls about 40 a minute during a run.
DRYDOCK_GET_RATE_MAX=240
# Finished runs kept in memory; the oldest go first.
DRYDOCK_MAX_RUNS=200

# Set only on the Vultr VM: the VM id. Without it nothing on screen claims a VM.
DRYDOCK_VM_ID=
